{
  // Choose under which architecture you need to build C++ libraries
  "abi": {
    "armeabi-v7a": false,
    "arm64-v8a": true,
    "x86": false,
    "x86_64": false
  },
  // If you do not have environment variables set, enter the path to SDK, NDK and CMAKE
  "environment": {
    // Full path: /opt/android-sdk
    "sdk_path": "/opt/android-sdk",
    // Full path: /opt/android-sdkcmake/3.18.1
    "cmake_path": "/opt/android-sdk/cmake/3.18.1",

    // Full path: /opt/android-sdk/ndk/23.1.7779620/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip

    "ndk_path": "/opt/android-sdk/ndk/23.1.7779620",
    "ndk_toolchains": "/toolchains/llvm/prebuilt/",
    "ndk_abi": "linux-x86_64",
    "ndk_strip": "/bin/llvm-strip"
  },
  // Output .so library name. Priority: command line > env (NMMP_LIB_NAME) > this file > default "nmmp"
  "lib_name": "nmmp",
  // VM .so library name. Priority: command line > env (NMMP_VM_LIB_NAME) > this file > default "nmmvm"
  "vm_lib_name": "nmmvm"
}