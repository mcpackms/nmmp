{
    // Windows 平台配置文件
    // 生成的 so 库名称, 优先级: 命令行参数(--libname=) > 环境变量(NMMP_LIB_NAME) > 此处配置 > 默认 nmmp
    "lib_name":"nmmp",
    // vm 子库名称, 优先级: 命令行参数(--vmlibname=) > 环境变量(NMMP_VM_LIB_NAME) > 此处配置 > 默认 nmmvm
    "vm_lib_name":"nmmvm",

    // Choose under which architecture you need to build C++ libraries
    "abi":{
        "armeabi-v7a":false,
        "arm64-v8a":true,
        "x86":false,
        "x86_64":false
    },
    // If you do not have environment variables set, enter the path to SDK, NDK and CMAKE
    "environment": {
        // Full path: G:/Android/Sdk
        "sdk_path": "G:/Android/Sdk",

        // Full path: G:/Android/Sdk/cmake/3.18.1
        "cmake_path": "G:/Android/Sdk/cmake/3.18.1",

        // Full path: G:/Android/Sdk/ndk/23.1.7779620/toolchains/llvm/prebuilt/windows-x86_64/bin/llvm-strip
        "ndk_path": "G:/Android/Sdk/ndk/23.1.7779620",
        "ndk_toolchains": "/toolchains/llvm/prebuilt/",
        "ndk_abi": "windows-x86_64",
        "ndk_strip": "/bin/llvm-strip"
    }
}